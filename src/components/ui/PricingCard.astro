---
import Button from './Button.astro';

interface Props {
  name: string;
  price: string;
  period?: string;
  description: string;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
  recommended?: boolean;
  class?: string;
}

const {
  name,
  price,
  period = '/month',
  description,
  features,
  ctaText = 'Get started',
  ctaHref = '/contact',
  recommended = false,
  class: className,
} = Astro.props;
---

<div class:list={['pricing-card', recommended && 'pricing-card--recommended', className]}>
  {recommended && <span class="pricing-card__accent-bar" aria-hidden="true"></span>}
  {recommended && <div class="pricing-card__badge">Recommended</div>}
  <div class="pricing-card__header">
    <h3 class="pricing-card__name">{name}</h3>
    <div class="pricing-card__price">
      <span class="pricing-card__amount">{price}</span>
      <span class="pricing-card__period">{period}</span>
    </div>
  </div>
  <p class="pricing-card__description">{description}</p>
  <ul class="pricing-card__features" role="list">
    {features.map((feature) => (
      <li class="pricing-card__feature">
        <span class="pricing-card__check" aria-hidden="true">
          <svg width="11" height="9" viewBox="0 0 11 9" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 4.5L4 7.5L10 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>
  <div class="pricing-card__cta">
    <Button
      href={ctaHref}
      variant={recommended ? 'secondary' : 'ghost'}
      size="md"
      withArrow={true}
    >
      {ctaText}
    </Button>
  </div>
</div>

<style>
  .pricing-card {
    position: relative;
    background: var(--color-surface-white);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base);
  }

  .pricing-card:hover {
    box-shadow: var(--shadow-md);
  }

  .pricing-card--recommended {
    border: 2px solid var(--color-brand-gold);
    box-shadow: var(--shadow-lg);
    z-index: 2;
    overflow: hidden;
  }

  .pricing-card--recommended:hover {
    box-shadow: var(--shadow-lg);
  }

  .pricing-card__accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #E4C56C 0%, var(--color-brand-gold) 50%, #8E732D 100%);
  }

  .pricing-card__badge {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    background: var(--color-brand-gold);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    border-radius: 99px;
    white-space: nowrap;
  }

  .pricing-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pricing-card--recommended .pricing-card__header {
    padding-right: 100px;
  }

  .pricing-card__name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
  }

  .pricing-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .pricing-card__amount {
    font-family: var(--font-mono);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--color-brand-teal);
    line-height: 1;
    letter-spacing: -1px;
  }

  .pricing-card__period {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .pricing-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin: 0;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .pricing-card__features {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pricing-card__feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .pricing-card__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--color-brand-gold-tint);
    color: var(--color-brand-gold-hover);
  }

  .pricing-card__cta {
    margin-top: auto;
  }

  .pricing-card__cta :global(.btn) {
    width: 100%;
    justify-content: center;
  }
</style>
