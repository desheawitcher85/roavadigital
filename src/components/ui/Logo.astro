---
import { Image } from 'astro:assets';
import logoFull from '../../assets/roava-logo.png';
import logoInverse from '../../assets/roava-logo-inverse.png';

interface Props {
  variant?: 'full' | 'mark' | 'inverse';
  width?: number;
  height?: number;
  linkTo?: string;
  class?: string;
}

const {
  variant = 'full',
  height = 40,
  linkTo,
  class: className,
} = Astro.props;

const altText = 'Roava Digital, Roanoke roofing marketing agency';
const isImg = variant !== 'mark';
const logoSrc = variant === 'inverse' ? logoInverse : logoFull;

// Natural dimensions: 1087x290. Scale to 2x the rendered height for retina.
const renderHeight = height;
const renderWidth = Math.round((renderHeight * logoFull.width) / logoFull.height);
---

{linkTo ? (
  <a href={linkTo} class:list={['logo-link', className]} aria-label="Roava Digital home">
    {isImg ? (
      <Image
        src={logoSrc}
        alt={altText}
        width={renderWidth * 2}
        height={renderHeight * 2}
        format="webp"
        quality={90}
        loading="eager"
        style={`height:${renderHeight}px; width: auto;`}
      />
    ) : (
      <img src="/favicon.svg" alt={altText} height={height} width={height} loading="eager" decoding="async" style={`height:${height}px; width: ${height}px;`} />
    )}
  </a>
) : (
  <span class:list={['logo-wrap', className]}>
    {isImg ? (
      <Image
        src={logoSrc}
        alt={altText}
        width={renderWidth * 2}
        height={renderHeight * 2}
        format="webp"
        quality={90}
        loading="eager"
        style={`height:${renderHeight}px; width: auto;`}
      />
    ) : (
      <img src="/favicon.svg" alt={altText} height={height} width={height} loading="eager" decoding="async" style={`height:${height}px; width: ${height}px;`} />
    )}
  </span>
)}

<style>
  .logo-link,
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  .logo-link img,
  .logo-wrap img {
    display: block;
    object-fit: contain;
  }
</style>
