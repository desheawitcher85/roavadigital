---
interface Props {
  quote: string;
  name: string;
  title?: string;
  company?: string;
  avatarSrc?: string;
  class?: string;
}

const { quote, name, title, company, avatarSrc, class: className } = Astro.props;
---

<figure class:list={['testimonial', className]}>
  <blockquote class="testimonial__quote">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="testimonial__attribution">
    {avatarSrc && (
      <img
        src={avatarSrc}
        alt={`${name}, ${title ?? company ?? ''}`}
        class="testimonial__avatar"
        width="48"
        height="48"
        loading="lazy"
      />
    )}
    <div class="testimonial__meta">
      <span class="testimonial__name">{name}</span>
      {(title || company) && (
        <span class="testimonial__role">
          {title}{title && company ? ', ' : ''}{company}
        </span>
      )}
    </div>
  </figcaption>
</figure>

<style>
  .testimonial {
    margin: 0;
    padding: var(--space-8);
    background: var(--color-surface-white);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    border-left: 5px solid var(--color-brand-gold);
  }

  .testimonial__quote {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-6) 0;
    background: transparent;
    border-radius: 0;
  }

  .testimonial__quote p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-primary);
    font-style: italic;
    max-width: none;
  }

  .testimonial__attribution {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .testimonial__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .testimonial__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .testimonial__name {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  .testimonial__role {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
</style>
