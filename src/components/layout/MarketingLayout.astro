---
import BaseLayout from './BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <Nav />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</BaseLayout>
