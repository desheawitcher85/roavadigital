---
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  body: string;
  primaryCtaText: string;
  primaryCtaHref: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  id?: string;
  class?: string;
}

const {
  eyebrow,
  headline,
  body,
  primaryCtaText,
  primaryCtaHref,
  secondaryCtaText,
  secondaryCtaHref,
  id,
  class: className,
} = Astro.props;
---

<section
  id={id}
  class:list={['cta-section', className]}
  aria-labelledby={id ? `${id}-headline` : 'cta-headline'}
>
  <div class="container cta-section__inner">
    {eyebrow && <span class="eyebrow eyebrow--on-dark eyebrow--center">{eyebrow}</span>}
    <h2 id={id ? `${id}-headline` : 'cta-headline'} class="cta-section__headline">
      {headline}
    </h2>
    <p class="cta-section__body">{body}</p>
    <div class="cta-section__actions">
      <Button href={primaryCtaHref} variant="secondary" size="lg" withArrow={true}>
        {primaryCtaText}
      </Button>
      {secondaryCtaText && secondaryCtaHref && (
        <a href={secondaryCtaHref} class="cta-section__secondary-link">
          {secondaryCtaText}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--color-brand-teal);
    padding: var(--section-padding-desktop) 0;
  }

  .cta-section__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .cta-section__headline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: var(--weight-extrabold);
    color: var(--color-text-inverse);
    line-height: var(--leading-snug);
    max-width: 700px;
    margin: 0;
  }

  .cta-section__body {
    font-size: var(--text-lg);
    color: rgba(250, 247, 241, 0.8);
    line-height: var(--leading-relaxed);
    max-width: 600px;
    margin: 0;
  }

  .cta-section__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-section__secondary-link {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    color: rgba(250, 247, 241, 0.7);
    text-decoration: none;
    border-bottom: 1px solid rgba(250, 247, 241, 0.3);
    padding-bottom: 2px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .cta-section__secondary-link:hover {
    color: var(--color-text-inverse);
    border-bottom-color: rgba(250, 247, 241, 0.7);
  }

  .cta-section__secondary-link:focus-visible {
    outline: 3px solid var(--color-brand-gold);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 600px) {
    .cta-section {
      padding: var(--section-padding-mobile) 0;
    }

    .cta-section__actions {
      flex-direction: column;
      width: 100%;
    }
  }
</style>
