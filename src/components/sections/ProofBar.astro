---
interface Props {
  label?: string;
  background?: 'cream' | 'white' | 'teal';
  class?: string;
}

const {
  label = 'Currently working with:',
  background = 'white',
  class: className,
} = Astro.props;
---

<div class:list={['proof-bar', `proof-bar--${background}`, className]}>
  <div class="container proof-bar__inner">
    <span class="proof-bar__label">{label}</span>
    <div class="proof-bar__clients">
      <slot />
    </div>
  </div>
</div>

<style>
  .proof-bar {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .proof-bar--cream {
    background: var(--color-surface-cream);
  }

  .proof-bar--white {
    background: var(--color-surface-white);
  }

  .proof-bar--teal {
    background: var(--color-brand-teal);
    border-color: rgba(250, 247, 241, 0.15);
  }

  .proof-bar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .proof-bar__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
  }

  .proof-bar--teal .proof-bar__label {
    color: rgba(250, 247, 241, 0.5);
  }

  .proof-bar__clients {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }
</style>
