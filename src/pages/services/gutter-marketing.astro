---
import MarketingLayout from '../../components/layout/MarketingLayout.astro';
import Button from '../../components/ui/Button.astro';
import CTASection from '../../components/sections/CTASection.astro';

const faqItems = [
  {
    question: 'Is it worth running separate marketing for gutters vs. roofing?',
    answer: "Yes, if gutter jobs are a meaningful revenue line for your business. Gutter replacement averages $1,000 to $2,500 per job in the Roanoke market. It's lower than a roof replacement, but the close rate is higher and jobs complete in a day. A roofer doing 30 gutter jobs per year from marketing is adding $30K to $75K in revenue from a single channel.",
  },
  {
    question: 'What does gutter marketing look like in practice?',
    answer: "Three channels work for gutter contractors: Google Business Profile (optimized for gutter-specific searches), Google Ads with job-type targeting, and service pages for 'gutter installation' and 'gutter replacement' in each city you serve. Review velocity matters here too since gutter jobs happen more frequently than roofing and give you more review opportunities.",
  },
  {
    question: 'When is gutter demand highest in Roanoke?',
    answer: "Fall is the highest demand period — leaves clog gutters from October through December. Spring (March through April) is second as homeowners assess winter damage. Storm events spike gutter repair demand year-round. A well-timed Google Ads campaign aligned to these windows can produce outsized returns.",
  },
  {
    question: 'Do you work with gutter-only contractors or only roofers who do gutters?',
    answer: "Both. If gutters are your primary service, the strategy is the same but calibrated differently: GBP category set to 'Gutter Cleaning Service' or 'Gutter Service,' dedicated service pages, and ad campaigns optimized for gutter keywords specifically.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Gutter Contractor Marketing',
  provider: { '@type': 'LocalBusiness', name: 'Roava Digital', url: 'https://roavadigital.com' },
  areaServed: ['Roanoke City, VA', 'Roanoke County, VA', 'Salem, VA', 'Vinton, VA', 'Botetourt County, VA', 'Bedford County, VA', 'New River Valley, VA'],
  description: 'Local SEO and Google Ads for gutter contractors in the Roanoke MSA. Seasonal demand strategy, GBP optimization, and targeted service pages.',
  url: 'https://roavadigital.com/services/gutter-marketing',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://roavadigital.com' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://roavadigital.com/services' },
    { '@type': 'ListItem', position: 3, name: 'Gutter Marketing', item: 'https://roavadigital.com/services/gutter-marketing' },
  ],
};
---

<MarketingLayout
  title="Gutter Contractor Marketing Roanoke | Roava Digital"
  description="Local SEO and Google Ads for gutter contractors in the Roanoke MSA. Seasonal demand strategy, GBP optimization, dedicated service pages. More calls, more jobs."
  canonicalUrl="https://roavadigital.com/services/gutter-marketing"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="service-hero" aria-labelledby="service-headline">
    <div class="container service-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list" role="list">
          <li><a href="/" class="breadcrumb__link">Home</a></li>
          <li aria-hidden="true" class="breadcrumb__sep">/</li>
          <li><a href="/services" class="breadcrumb__link">Services</a></li>
          <li aria-hidden="true" class="breadcrumb__sep">/</li>
          <li aria-current="page" class="breadcrumb__current">Gutter Marketing</li>
        </ol>
      </nav>
      <span class="eyebrow">Roanoke MSA</span>
      <h1 id="service-headline" class="service-hero__headline">
        Fill your gutter calendar without chasing referrals
      </h1>
      <p class="service-hero__subhead">
        Gutter jobs are steady, repeatable revenue. A Roanoke contractor doing 2 to 3 gutter jobs per week at $1,500 average is adding $150K to $200K per year. Most of that demand exists in Google right now and goes to whoever shows up first.
      </p>
      <p class="hero-lead">Gutter marketing for Roanoke contractors uses three main channels: Google Business Profile optimized for gutter-specific searches, targeted Google Ads for high-intent keywords like "gutter installation Roanoke" and "gutter replacement Salem VA," and dedicated service pages for each job type and city. Seasonal demand spikes in fall and spring. Storm events drive year-round repair volume.</p>
      <div class="service-hero__actions">
        <Button href="/free-audit" variant="primary" size="lg" withArrow={true}>Get a free audit</Button>
        <Button href="/contact" variant="ghost" size="lg">Talk about gutter marketing</Button>
      </div>
    </div>
  </section>

  <section class="service-section service-section--white" aria-labelledby="strategy-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="strategy-heading">What a gutter marketing strategy looks like</h2>
        <p class="section-head__intro">Gutter demand is predictable. The marketing strategy should be built around that seasonality.</p>
      </div>
      <div class="service-pillars">
        <div class="service-pillar">
          <div class="service-pillar__number" aria-hidden="true">01</div>
          <div class="service-pillar__content">
            <h3 class="service-pillar__title">GBP optimized for gutter searches</h3>
            <p class="service-pillar__body">Most roofer GBP profiles are set up for roofing and mention gutters as an afterthought. If gutters are a primary revenue line, the profile needs a gutter-specific service category, a dedicated service list, and photos of completed gutter work. Roanoke homeowners searching specifically for a gutter company need to see your listing as relevant to that search.</p>
          </div>
        </div>
        <div class="service-pillar">
          <div class="service-pillar__number" aria-hidden="true">02</div>
          <div class="service-pillar__content">
            <h3 class="service-pillar__title">Seasonal and storm-triggered Google Ads</h3>
            <p class="service-pillar__body">Fall leaf drop (October through December) is the highest-volume gutter cleaning and replacement season in Roanoke. Spring (March through April) is second. Ads running at standard bids year-round miss the windows when demand spikes and competition is highest.</p>
            <p class="service-pillar__body">We build seasonal campaigns that increase bids during peak windows and pull back during low-demand months to protect budget efficiency.</p>
          </div>
        </div>
        <div class="service-pillar">
          <div class="service-pillar__number" aria-hidden="true">03</div>
          <div class="service-pillar__content">
            <h3 class="service-pillar__title">Gutter service pages by job type and city</h3>
            <p class="service-pillar__body">One page titled "Gutter Services" won't rank for "seamless gutter installation Salem VA" or "gutter guard installation Botetourt County." Each job type (installation, replacement, cleaning, guards) and each service city needs a dedicated page built around the actual search terms homeowners use.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="service-faq service-section--cream" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="faq-heading">Common questions about gutter marketing</h2>
      </div>
      <div class="faq-list">
        {faqItems.map((item, i) => (
          <div class="faq-item">
            <button class="faq-trigger" aria-expanded="false" aria-controls={`faq-answer-${i}`} id={`faq-trigger-${i}`}>
              {item.question}
              <svg class="faq-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="faq-answer" id={`faq-answer-${i}`} role="region" aria-labelledby={`faq-trigger-${i}`} hidden>
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Next step"
    headline="See where your gutter business stands in local search"
    body="A free audit covers your GBP setup, citation health, competitor gaps, and site speed. 48 hours. No obligation."
    primaryCtaText="Request a free audit"
    primaryCtaHref="/free-audit"
    secondaryCtaText="See pricing"
    secondaryCtaHref="/pricing"
  />
</MarketingLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      const answerId = trigger.getAttribute('aria-controls');
      const answer = answerId ? document.getElementById(answerId) : null;
      trigger.setAttribute('aria-expanded', String(!expanded));
      if (answer) answer.hidden = expanded;
    });
  });
</script>

<style>
  .service-hero { background: var(--color-surface-cream); padding: var(--space-16) 0; }
  .service-hero__inner { max-width: 860px; display: flex; flex-direction: column; gap: var(--space-6); }
  .breadcrumb__list { display: flex; align-items: center; gap: var(--space-2); list-style: none; padding: 0; margin: 0; flex-wrap: wrap; }
  .breadcrumb__link { font-size: var(--text-sm); color: var(--color-text-tertiary); text-decoration: none; }
  .breadcrumb__link:hover { color: var(--color-brand-teal); }
  .breadcrumb__sep { font-size: var(--text-sm); color: var(--color-text-tertiary); }
  .breadcrumb__current { font-size: var(--text-sm); color: var(--color-text-secondary); font-weight: var(--weight-medium); }
  .service-hero__headline { font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: var(--weight-black); line-height: 1.08; letter-spacing: -1px; color: var(--color-text-primary); margin: 0 0 var(--space-4); }
  .service-hero__subhead { font-size: var(--text-lg); color: var(--color-text-secondary); line-height: var(--leading-relaxed); max-width: 680px; margin: 0; }
  .hero-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 720px;
  }
  .service-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; margin-top: var(--space-2); }
  .service-section { padding: var(--space-16) 0; }
  .service-section--white { background: var(--color-surface-white); }
  .service-section--cream { background: var(--color-surface-cream); }
  .service-pillars { display: flex; flex-direction: column; gap: var(--space-10); }
  .service-pillar { display: grid; grid-template-columns: 48px 1fr; gap: var(--space-6); padding-bottom: var(--space-10); border-bottom: 1px solid var(--color-border-subtle); }
  .service-pillar:last-child { border-bottom: none; padding-bottom: 0; }
  .service-pillar__number { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--color-brand-gold); background: var(--color-brand-gold-tint); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 3px; letter-spacing: 0.5px; }
  .service-pillar__content { display: flex; flex-direction: column; gap: var(--space-3); }
  .service-pillar__title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: var(--weight-bold); color: var(--color-text-primary); margin: 0; line-height: var(--leading-snug); }
  .service-pillar__body { font-size: var(--text-base); color: var(--color-text-secondary); line-height: var(--leading-relaxed); margin: 0; }
  .service-faq { padding: var(--space-16) 0; }
  .faq-list { display: flex; flex-direction: column; border-top: 1px solid var(--color-border-subtle); max-width: 760px; }
  .faq-item { border-bottom: 1px solid var(--color-border-subtle); }
  .faq-trigger { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-5) 0; background: none; border: none; text-align: left; font-family: var(--font-body); font-size: var(--text-base); font-weight: var(--weight-semibold); color: var(--color-text-primary); cursor: pointer; transition: color var(--transition-fast); }
  .faq-trigger:hover { color: var(--color-brand-teal); }
  .faq-trigger:focus-visible { outline: 3px solid var(--color-brand-gold); outline-offset: 2px; border-radius: var(--radius-sm); }
  .faq-icon { flex-shrink: 0; color: var(--color-brand-gold); transition: transform var(--transition-fast); }
  .faq-trigger[aria-expanded="true"] .faq-icon { transform: rotate(180deg); }
  .faq-answer { padding-bottom: var(--space-5); }
  .faq-answer p { font-size: var(--text-base); color: var(--color-text-secondary); line-height: var(--leading-relaxed); margin: 0; max-width: 660px; }
  @media (max-width: 900px) { .service-pillar { grid-template-columns: 1fr; gap: var(--space-3); } .service-pillar__number { margin-top: 0; } }
  @media (max-width: 600px) { .service-hero { padding: var(--space-12) 0; } }
</style>
